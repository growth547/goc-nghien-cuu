---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import Wordmark from "./Wordmark.astro";
import { appLink } from "@/utils/appLink";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale ?? config.site.lang;
// Files (rss.xml) must not get the trailing slash getRelativeLocaleUrl adds to pages.
const href = (path: string) =>
  /\.\w+$/.test(path) ? getAssetPath(path) : getRelativeLocaleUrl(locale, path);

const columns = [
  {
    title: "Công cụ",
    links: [
      { path: "cong-cu/bo-khao-sat", label: "Bộ khảo sát khoá luận" },
      { path: "cong-cu/phan-tich-du-lieu", label: "Phân tích dữ liệu, chương 4" },
      { path: "cong-cu/tinh-co-mau", label: "Máy tính cỡ mẫu" },
      { path: "cong-cu/cronbach-alpha", label: "Cronbach's alpha" },
    ],
  },
  {
    title: "Thư viện",
    links: [
      { path: "thang-do", label: "Thư viện thang đo" },
      { path: "khai-niem", label: "Thang đo theo khái niệm" },
      { path: "mau-bang-hoi", label: "Mẫu bảng hỏi theo đề tài" },
      { path: "du-lieu", label: "Dữ liệu thứ cấp Việt Nam" },
      { path: "bien-nghien-cuu", label: "Biến nghiên cứu tài chính" },
      { path: "nguong-chap-nhan", label: "Ngưỡng chấp nhận các chỉ số" },
    ],
  },
  {
    title: config.site.title,
    links: [
      { path: "posts", label: "Bài viết" },
      { path: "about", label: "Giới thiệu" },
      { path: "search", label: "Tìm kiếm" },
      { path: "rss.xml", label: "RSS" },
    ],
  },
];
---

<footer
  class:list={[
    "border-border bg-surface border-t",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="app-layout grid grid-cols-2 gap-x-6 gap-y-8 py-10 sm:py-14 md:grid-cols-[1.4fr_repeat(3,1fr)] md:gap-10">
    <div class="col-span-2 max-w-sm md:col-span-1">
      <a href={href("")} class="inline-flex items-center gap-2.5 rounded-lg">
        <Wordmark />
      </a>
      <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
        Thang đo, mẫu bảng hỏi, công cụ tính toán và dữ liệu cho sinh viên làm
        khoá luận, luận văn. Miễn phí, không cần đăng ký.
      </p>
    </div>
    {
      columns.map(col => (
        <nav aria-label={col.title} class:list={[col.links.length > 5 && "row-span-2 md:row-span-1"]}>
          <h2 class="text-foreground text-xs font-semibold tracking-wider uppercase">{col.title}</h2>
          <ul class="mt-2 text-sm md:mt-3 md:space-y-0.5">
            {col.links.map(l => (
              <li>
                <a
                  href={href(l.path)}
                  class="text-muted-foreground hover:text-accent flex min-h-10 items-center py-1 leading-snug transition-colors md:inline-flex md:min-h-8"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="border-border border-t">
    <div
      class="app-layout flex flex-col items-center justify-between gap-3 py-5 text-[0.8125rem] sm:flex-row"
    >
      <p class="text-muted-foreground max-w-2xl text-center leading-relaxed sm:text-start">
        © {currentYear} Góc Nghiên Cứu · Một số link trên trang là link giới thiệu
        (affiliate), ví dụ tới{" "}
        <a class="text-accent underline underline-offset-4" href={appLink("home", "footer")} rel="sponsored noopener">Genius Data</a>.
      </p>
      <Socials />
    </div>
  </div>
</footer>
