---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import Wordmark from "./Wordmark.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so active-section checks work regardless of deploy subdirectory.
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);
const firstSegment = currentPath.split("/").filter(p => p.trim())[0] ?? "";

// Tags and archives belong to the articles.
const sectionOf: Record<string, string> = {
  tags: "posts",
  archives: "posts",
};
const activeSection = sectionOf[firstSegment] ?? firstSegment;

const navItems = [
  { path: "cong-cu", label: "Công cụ" },
  { path: "thang-do", label: "Thang đo" },
  { path: "khai-niem", label: "Khái niệm" },
  { path: "mau-bang-hoi", label: "Mẫu bảng hỏi" },
  { path: "du-lieu", label: "Dữ liệu" },
  { path: "posts", label: t.nav.posts },
  { path: "about", label: t.nav.about },
];
const kitHref = getRelativeLocaleUrl(locale, "cong-cu/bo-khao-sat");
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-accent text-accent-foreground fixed start-4 -top-20 z-[60] rounded-lg px-4 py-2 font-semibold shadow-lg transition-all focus:top-3"
>
  {t.a11y.skipToContent}
</a>

<header
  id="site-header"
  class="border-border bg-background/90 sticky top-0 z-40 border-b backdrop-blur-md"
>
  <div class="app-layout flex h-16 items-center justify-between gap-3">
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="flex items-center gap-2.5 rounded-lg py-1 whitespace-nowrap"
      aria-label={`${site.title}, về trang chủ`}
    >
      <Wordmark />
    </a>

    <nav aria-label="Điều hướng chính" class="hidden lg:block">
      <ul class="flex items-center gap-0.5">
        {
          navItems.map(item => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, item.path)}
                aria-current={activeSection === item.path ? "page" : undefined}
                class:list={[
                  "hover:text-accent hover:bg-accent-soft/60 block rounded-lg px-2.5 py-2 text-[0.92rem] font-medium whitespace-nowrap transition-colors",
                  activeSection === item.path
                    ? "active-nav"
                    : "text-foreground/80",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      {
        features.search !== false && (
          <a
            href={getRelativeLocaleUrl(locale, "search")}
            class="text-foreground/80 hover:text-accent hover:bg-accent-soft/60 grid size-10 place-items-center rounded-lg transition-colors"
            title={t.nav.search}
            aria-label={t.nav.search}
            aria-current={firstSegment === "search" ? "page" : undefined}
          >
            <IconSearch class="size-5" aria-hidden="true" />
          </a>
        )
      }
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            type="button"
            class="text-foreground/80 hover:text-accent hover:bg-accent-soft/60 relative grid size-10 place-items-center rounded-lg transition-colors"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon
              class="absolute size-5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
              aria-hidden="true"
            />
            <IconSunHigh
              class="absolute size-5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
              aria-hidden="true"
            />
          </button>
        )
      }
      <a
        href={kitHref}
        class="btn ms-1 hidden min-h-10 px-4 py-2 text-sm sm:inline-flex lg:hidden"
      >
        Tạo bảng hỏi
      </a>
      <button
        id="menu-btn"
        type="button"
        class="text-foreground hover:bg-accent-soft/60 grid size-10 place-items-center rounded-lg lg:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden size-6" aria-hidden="true" />
        <IconMenuDeep id="menu-icon" class="size-6" aria-hidden="true" />
      </button>
    </div>
  </div>

  <nav
    id="menu-items"
    aria-label="Điều hướng chính"
    class="border-border bg-background hidden border-t lg:hidden"
  >
    <ul class="app-layout grid gap-1 py-3 sm:grid-cols-2">
      {
        navItems.map(item => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, item.path)}
              aria-current={activeSection === item.path ? "page" : undefined}
              class:list={[
                "hover:bg-accent-soft/60 flex min-h-12 items-center rounded-lg px-3 text-base font-medium",
                activeSection === item.path ? "active-nav" : "text-foreground",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2 pb-1 sm:col-span-2">
        <a href={kitHref} class="btn w-full">Tạo bảng hỏi miễn phí</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector<HTMLElement>("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    const setOpen = (open: boolean) => {
      menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
      menuBtn.setAttribute("aria-label", open ? closeLabel : openLabel);
      menuItems.classList.toggle("hidden", !open);
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
    };

    menuBtn.addEventListener("click", () => {
      setOpen(menuBtn.getAttribute("aria-expanded") !== "true");
    });

    menuItems.addEventListener("keydown", e => {
      if (e.key === "Escape") {
        setOpen(false);
        menuBtn.focus();
      }
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
