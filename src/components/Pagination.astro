---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(Astro.currentLocale);
// Pages are served as folders; link to "/posts/" not "/posts" to avoid a redirect.
const withSlash = (url?: string) => (url && !url.endsWith("/") ? `${url}/` : url);
const prev = withSlash(page.url.prev);
const next = withSlash(page.url.next);
---

{
  page.lastPage > 1 && (
    <nav
      class="text-muted-foreground mt-auto mb-12 flex items-center justify-center gap-3 text-sm font-medium"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!prev}
        href={prev}
        class:list={["select-none border-border bg-surface hover:border-accent rounded-lg border px-4 py-2", { "opacity-50": !prev }]}
        aria-label={t.a11y.goToPreviousPage}
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        {t.pagination.prev}
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!next}
        href={next}
        class:list={["select-none border-border bg-surface hover:border-accent rounded-lg border px-4 py-2", { "opacity-50": !next }]}
        aria-label={t.a11y.goToNextPage}
      >
        {t.pagination.next}
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
