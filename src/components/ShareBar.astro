---
/**
 * "Send to your group" bar for tool pages and posts. Plain share URLs only (no
 * third-party scripts). Every shared link carries utm_source=share&utm_medium=<channel>.
 * Zalo has no share URL that works without its SDK, so the Zalo button opens the
 * phone's share sheet (Zalo is in it) or, on a computer, copies the link.
 * Messenger's fb-messenger:// link only works in the mobile app, so that button
 * is shown on touch screens only (CSS, so nothing shifts after load).
 */
type Props = { class?: string; note?: string };
const {
  class: className = "mt-10",
  note = "Cả nhóm khoá luận dùng chung một công cụ, đỡ lệch số khi ghép bài.",
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const withUtm = (medium: string) => {
  const u = new URL(pageUrl);
  u.searchParams.set("utm_source", "share");
  u.searchParams.set("utm_medium", medium);
  return u.href;
};
const fbHref = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(withUtm("facebook"))}`;
const messengerHref = `fb-messenger://share/?link=${encodeURIComponent(withUtm("messenger"))}`;
const btn =
  "share-btn border-border-strong text-foreground hover:border-accent hover:text-accent focus-visible:outline-accent inline-flex min-h-11 items-center gap-2 rounded-lg border px-3.5 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-2";
---

<section
  class:list={["share-bar border-border bg-surface max-w-3xl rounded-xl border p-4", className]}
  aria-labelledby="share-bar-title"
  data-share-url={pageUrl}
  data-pagefind-ignore
>
  <h2 id="share-bar-title" class="text-foreground text-base font-bold">Gửi cho bạn cùng nhóm</h2>
  <p class="text-muted-foreground mt-1 text-sm">{note}</p>
  <div class="mt-3 flex flex-wrap gap-2">
    <button type="button" class={btn} data-share="zalo">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z" /></svg>
      Zalo
    </button>
    <a class={btn} href={fbHref} target="_blank" rel="noopener noreferrer" data-share="facebook">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="currentColor"><path d="M14 8V6.5c0-.8.2-1.5 1.5-1.5H17V2h-2.6C11.5 2 11 4 11 6v2H9v3h2v11h3V11h2.5l.5-3Z" /></svg>
      Facebook
    </a>
    <a class:list={[btn, "share-touch-only"]} href={messengerHref} data-share="messenger">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3C7 3 3 6.7 3 11.3c0 2.6 1.3 4.9 3.3 6.4V21l3-1.7c.9.3 1.8.4 2.7.4 5 0 9-3.7 9-8.4S17 3 12 3Z" /><path d="m7.5 13.5 3-3 2.5 2 3.5-3" /></svg>
      Messenger
    </a>
    <button type="button" class={btn} data-share="copy">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
      Chép link
    </button>
  </div>
  <p class="share-status text-accent mt-2 min-h-5 text-sm font-medium" role="status" aria-live="polite"></p>
</section>

<style>
  .share-touch-only {
    display: none;
  }
  @media (pointer: coarse) {
    .share-touch-only {
      display: inline-flex;
    }
  }
</style>

<script>
  // One delegated listener survives ClientRouter page swaps.
  const withUtm = (url: string, medium: string) => {
    const u = new URL(url);
    u.searchParams.set("utm_source", "share");
    u.searchParams.set("utm_medium", medium);
    return u.href;
  };
  const track = (channel: string) => {
    const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
    if (typeof g === "function") g("event", "share_click", { channel, transport_type: "beacon" });
  };
  const touch = () => window.matchMedia("(pointer: coarse)").matches;

  document.addEventListener("click", async event => {
    const el = (event.target as Element | null)?.closest<HTMLElement>("[data-share]");
    const bar = el?.closest<HTMLElement>(".share-bar");
    if (!el || !bar) return;
    const channel = el.dataset.share ?? "";
    const base = bar.dataset.shareUrl ?? location.href.split(/[?#]/)[0];
    const status = bar.querySelector<HTMLElement>(".share-status");
    const say = (msg: string) => {
      if (status) status.textContent = msg;
    };
    if (channel === "facebook" || channel === "messenger") {
      track(channel);
      return; // plain link, let it open
    }
    event.preventDefault();
    // On phones the share sheet lists Zalo, Messenger and the rest.
    if (touch() && typeof navigator.share === "function") {
      const medium = channel === "zalo" ? "zalo" : "webshare";
      track(medium);
      try {
        await navigator.share({ title: document.title, url: withUtm(base, medium) });
      } catch {
        // Closing the sheet is not an error worth showing.
      }
      return;
    }
    const medium = channel === "zalo" ? "zalo" : "copy";
    track(medium);
    const link = withUtm(base, medium);
    try {
      await navigator.clipboard.writeText(link);
      say(channel === "zalo" ? "Đã chép link. Mở Zalo và dán vào nhóm." : "Đã chép link, dán vào nhóm chat là xong.");
    } catch {
      window.prompt("Chép link này:", link);
    }
  });
</script>
