---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import { ogCardFor } from "@/utils/ogCards";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  /** Keep the page out of search results while letting crawlers follow its links. */
  noindex?: boolean;
  /** Open Graph type: "website" for most pages, "article" for posts. */
  ogType?: "website" | "article";
};

const { site } = config;

// Pages with their own share card (public/og/, 1200x630) use it unless a post sets ogImage.
const ogCard = ogCardFor(Astro.url.pathname);

const {
  title: rawTitle = site.title,
  description = site.description,
  ogImage = ogCard ? getAssetPath(ogCard.file) : resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  noindex = false,
  ogType = "website",
} = Astro.props;

// Search results show ~60 characters; when "<page> | <site>" would be cut off,
// drop the site-name suffix so the page's own words stay visible.
const TITLE_MAX = 60;
const titleSuffix = ` | ${site.title}`;
const title =
  rawTitle.length > TITLE_MAX && rawTitle.endsWith(titleSuffix)
    ? rawTitle.slice(0, -titleSuffix.length)
    : rawTitle;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
// public/default-og.png is 1200x630; declaring it lets Facebook/Zalo render the card on first share.
// The per-page cards are the same size.
const isDefaultOgImage =
  ogImage === resolveDefaultOgImagePath(config) ||
  (ogCard !== undefined && ogImage === getAssetPath(ogCard.file));
const ogImageAlt = ogCard && ogImage === getAssetPath(ogCard.file) ? ogCard.alt : title;
// getRelativeLocaleUrl appends a trailing slash ("rss.xml/"), which 404s on a static host.
const rssHref = getAssetPath("rss.xml");
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={Astro.currentLocale ?? site.lang}
  class="overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <!-- Font -->
    <Font
      cssVariable="--font-be-vietnam-pro"
      preload={[
        // Vietnamese text needs both subsets: basic letters come from "latin",
        // letters with diacritics from "vietnamese". Headings use 600/700, whose
        // late swap was the main layout shift on data pages (PSI: CLS 0.069).
        { subset: "latin", weight: 400, style: "normal" },
        { subset: "vietnamese", weight: 400, style: "normal" },
        { subset: "latin", weight: 600, style: "normal" },
        { subset: "latin", weight: 700, style: "normal" },
      ]}
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    {
      isDefaultOgImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="vi_VN" />

    <!-- Twitter / X (name=, not property=) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <!-- Filled at runtime by theme.ts to match the current background colour -->
    <meta name="theme-color" content="" />

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!--
      Inline FOUC-prevention script: sets data-theme on <html> before
      the browser paints. Runs synchronously, no defer/async.
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        const root = document.firstElementChild;
        root?.setAttribute("data-theme", theme);
        root?.classList.toggle("dark", theme === "dark");
        // Expose value so theme.ts can skip re-detection.
        window.__theme = { value: theme };
      })();
    </script>

    {
      site.gaMeasurementId && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}`}
          />
          <script is:inline define:vars={{ gaId: site.gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            gtag("js", new Date());
            // ClientRouter swaps pages without a full load, so page views are sent on
            // every astro:page-load (which also fires on the first load) instead.
            gtag("config", gaId, { send_page_view: false });
            document.addEventListener("astro:page-load", () => {
              gtag("event", "page_view", {
                page_location: location.href,
                page_title: document.title,
              });
            });
          </script>
        </>
      )
    }

    <ClientRouter />
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col"
  >
    <slot />
    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
