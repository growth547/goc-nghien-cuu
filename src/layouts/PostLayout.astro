---
import Layout from "./Layout.astro";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import config from "@/config";

type Props = {
  /** Full <title>, usually "<post title> | <site title>". */
  title?: string;
  /** Post title without the site suffix, used as the JSON-LD headline. */
  headline?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
};

const { site } = config;

const {
  title,
  headline,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
} = Astro.props;

const pageUrl = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(
  ogImage ?? resolveDefaultOgImagePath(config),
  Astro.site ?? Astro.url
).href;
const siteUrl = new URL(site.url).href;
const lastModified = modDatetime ?? pubDatetime;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: headline ?? title ?? site.title,
  ...(description && { description }),
  image: [imageUrl],
  inLanguage: "vi",
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  url: pageUrl,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(lastModified && { dateModified: lastModified.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
  publisher: {
    "@type": "Organization",
    name: site.title,
    url: siteUrl,
    logo: {
      "@type": "ImageObject",
      url: new URL("favicon.svg", siteUrl).href,
    },
  },
};
---

<Layout {title} {description} {ogImage} {canonicalURL} ogType="article">
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
