---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import ShareBar from "@/components/ShareBar.astro";
import Icon from "@/components/Icon.astro";
import { appLink } from "@/utils/appLink";
import config from "@/config";

type Props = { slug: string; title: string; h1: string; description: string; lede: string; html: string };
const { slug, title, h1, description, lede, html } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
// "What comes next" for each tool, in thesis order: [path, anchor, rest of the sentence].
const NEXT: Record<string, [string, string, string][]> = {
  "bo-khao-sat": [
    ["/cong-cu/tinh-co-mau/", "tính cỡ mẫu nghiên cứu", "theo số mũi tên của mô hình"],
    ["/cong-cu/ve-mo-hinh/", "vẽ mô hình nghiên cứu", "cho chương 2"],
    ["/cong-cu/trich-dan-apa/", "tạo trích dẫn APA 7", "cho bài gốc của từng thang đo"],
    ["/posts/cach-tao-phieu-khao-sat-google-forms/", "đưa bảng hỏi lên Google Form", "đúng cách cho thang Likert"],
  ],
  "lam-sach-du-lieu": [
    ["/cong-cu/cronbach-alpha/", "tính Cronbach's alpha", "cho từng thang đo"],
    ["/cong-cu/phan-tich-du-lieu/", "phân tích dữ liệu khảo sát", "(EFA, tương quan, hồi quy)"],
    ["/posts/phat-hien-cau-tra-loi-khao-sat-do-ai-viet/", "soát câu trả lời tự luận do AI viết", "trước khi giữ phiếu"],
  ],
  "phan-tich-du-lieu": [
    ["/cong-cu/bac-si-ket-qua/", "chẩn đoán kết quả không đạt", "khi alpha, KMO hay VIF lệch ngưỡng"],
    ["/cong-cu/trung-gian-dieu-tiet/", "kiểm định biến trung gian, điều tiết", "nếu mô hình có biến M hoặc W"],
    ["/cong-cu/trich-dan-apa/", "định dạng tài liệu tham khảo APA 7", "cho chương 4"],
    ["/posts/ham-y-quan-tri-cach-viet-chuong-5/", "viết hàm ý quản trị ở chương 5", "từ hệ số hồi quy và điểm trung bình"],
  ],
  "bac-si-ket-qua": [
    ["/cong-cu/phan-tich-du-lieu/", "chạy lại phân tích dữ liệu", "sau khi xử lý"],
    ["/cong-cu/trung-gian-dieu-tiet/", "kiểm định trung gian, điều tiết", "khi giả thuyết trực tiếp bị bác bỏ nhưng có lý thuyết về cơ chế gián tiếp"],
    ["/posts/ham-y-quan-tri-cach-viet-chuong-5/#khi-gia-thuyet-bi-bac-bo", "viết chương 5 khi giả thuyết bị bác bỏ", ""],
  ],
  "pls-sem": [
    ["/cong-cu/bac-si-ket-qua/", "chẩn đoán chỉ số không đạt", "khi hệ số tải, AVE hay HTMT lệch ngưỡng"],
    ["/cong-cu/trich-dan-apa/", "trích dẫn Hair và cộng sự theo APA 7", "cho chương 3"],
  ],
  "trung-gian-dieu-tiet": [
    ["/cong-cu/ve-mo-hinh/", "vẽ mô hình có biến trung gian, điều tiết", ""],
    ["/cong-cu/tinh-co-mau/", "tính cỡ mẫu", "cho mô hình nhiều đường dẫn"],
    ["/cong-cu/trich-dan-apa/", "trích dẫn Hayes (2022) theo APA 7", ""],
  ],
  "ve-mo-hinh": [
    ["/cong-cu/bo-khao-sat/", "tạo bảng hỏi từ các khái niệm trong mô hình", ""],
    ["/cong-cu/trung-gian-dieu-tiet/", "kiểm định biến trung gian, điều tiết", "sau khi có dữ liệu"],
  ],
  "chon-phuong-phap": [
    ["/cong-cu/tinh-co-mau/", "tính cỡ mẫu", "cho phương pháp đã chọn"],
    ["/cong-cu/trung-gian-dieu-tiet/", "kiểm định trung gian, điều tiết kiểu PROCESS", "nếu câu hỏi nghiên cứu là cơ chế hay điều kiện"],
  ],
  "tinh-co-mau": [
    ["/cong-cu/bo-khao-sat/", "tạo bảng hỏi khảo sát", "từ thang đo gốc"],
    ["/cong-cu/trich-dan-apa/", "trích dẫn APA 7", "cho nguồn công thức cỡ mẫu"],
    ["/posts/cach-thu-du-mau-khao-sat-nhanh/", "thu đủ số phiếu đó nhanh", "mà không làm hỏng dữ liệu"],
  ],
  "trich-dan-apa": [
    ["/thang-do/", "thư viện thang đo", "(mỗi thang đo có sẵn tài liệu tham khảo APA)"],
    ["/cong-cu/bo-khao-sat/", "bộ khảo sát khoá luận", "(xuất Word kèm trích dẫn thang đo)"],
  ],
  "cronbach-alpha": [
    ["/cong-cu/phan-tich-du-lieu/", "phân tích EFA và hồi quy", "cho toàn bộ file khảo sát"],
    ["/cong-cu/bac-si-ket-qua/", "xử lý Cronbach's alpha thấp", "đúng quy tắc"],
  ],
  "tinh-chi-so-tai-chinh": [
    ["/bien-nghien-cuu/", "định nghĩa biến nghiên cứu tài chính", "kèm code Stata"],
    ["/cong-cu/trich-dan-apa/", "trích dẫn báo cáo tài chính, thông tư theo APA 7", ""],
  ],
};
const next = NEXT[slug] ?? [];
// Launch-day feedback: Vietnamese issue template, page prefilled.
const feedbackUrl = `https://github.com/growth547/goc-nghien-cuu/issues/new?${new URLSearchParams({
  template: "gop-y-cong-cu.md",
  title: `[Góp ý] ${h1}`,
  body: `**Trang:** ${url}

**Công cụ có ích với bạn không?**

**Chỗ sai hoặc khó hiểu:**

**Bạn muốn có thêm gì?**
`,
})}`;
// Tools that carry their own Genius Data note (after the result or in the guide): one sponsored note per page, so no footer line.
const OWN_CTA = new Set(["tinh-co-mau", "pls-sem", "phan-tich-du-lieu", "cronbach-alpha", "ve-mo-hinh", "bo-khao-sat"]);
const ld = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: h1,
  url,
  description,
  applicationCategory: "EducationalApplication",
  operatingSystem: "Any",
  inLanguage: "vi",
  isAccessibleForFree: true,
  browserRequirements: "Requires JavaScript. Works in current versions of Chrome, Edge, Firefox and Safari.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "VND" },
  publisher: { "@type": "Organization", name: config.site.title, url: config.site.url },
};
const crumbsLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Trang chủ", item: config.site.url },
    { "@type": "ListItem", position: 2, name: "Công cụ", item: new URL("cong-cu/", config.site.url).href },
    { "@type": "ListItem", position: 3, name: h1, item: url },
  ],
};
---

<Layout title={`${title} | ${config.site.title}`} description={description}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(crumbsLd)} />
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout tool-page pb-10">
    <header class="tool-head">
      <ul class="text-muted-foreground mb-3 hidden flex-wrap gap-x-4 gap-y-1 text-[0.8125rem] font-medium sm:flex" aria-label="Về công cụ này">
        <li class="flex items-center gap-1.5"><Icon name="check" class="text-accent size-4" />Miễn phí, không cần tài khoản</li>
        <li class="flex items-center gap-1.5"><Icon name="shield" class="text-accent size-4" />Dữ liệu xử lý trên trình duyệt của bạn</li>
      </ul>
      <h1 class="text-foreground font-bold" style="font-size: var(--fs-h1); line-height: var(--lh-tight)">{h1}</h1>
      <p id="tool-lede" class="text-muted-foreground mt-2.5 max-w-3xl leading-relaxed max-sm:line-clamp-3 sm:mt-3" style="font-size: var(--fs-lead)">{lede}</p>
      <button type="button" id="tool-lede-more" data-no-track class="text-accent min-h-11 text-sm font-semibold underline underline-offset-4 sm:hidden" aria-controls="tool-lede" aria-expanded="false">Đọc tiếp giới thiệu</button>
    </header>
    <div class="mb-6 max-sm:mb-3"></div>
    <slot />
    <Fragment set:html={html} />
    <ShareBar wide class="mt-10" />
    <p class="text-muted-foreground mt-3 text-sm">
      Bạn thấy công cụ này có ích không?{" "}
      <a class="text-accent font-semibold underline underline-offset-4" href={feedbackUrl} target="_blank" rel="noopener" data-feedback>Gửi góp ý</a>
      {" "}(mở GitHub, cần tài khoản GitHub; đừng dán dữ liệu thật).
    </p>
    {
      Astro.slots.has("guide") && (
        <div class="tool-guide app-prose max-w-app border-border mt-12 border-t pt-10">
          <slot name="guide" />
        </div>
      )
    }
    {
      next.length > 0 && (
        <nav class="mt-12" aria-labelledby="tool-next-title">
          <h2 id="tool-next-title" class="text-foreground text-base font-bold">Bước tiếp theo</h2>
          <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {next.map(([href, anchor, rest]) => (
              <li>
                <a class="card group gap-1 p-4" href={href}>
                  <span class="card-title text-accent flex items-start justify-between gap-2 text-[0.95rem]">
                    <span>{anchor}</span>
                    <Icon name="arrow" class="mt-0.5 size-4 flex-none transition-transform group-hover:translate-x-0.5" />
                  </span>
                  {rest && <span class="card-meta">{rest}</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <p class="text-muted-foreground mt-8 max-w-3xl text-sm">
      Đây là một trong {Object.keys(NEXT).length} <a class="text-accent underline underline-offset-4" href="/cong-cu/">công cụ nghiên cứu khoa học miễn phí</a> của Góc Nghiên Cứu.
    </p>
    {
      !OWN_CTA.has(slug) && (
        <p class="text-muted-foreground mt-4 max-w-3xl text-sm">Cần người trả lời đúng đối tượng cho khảo sát? Tham khảo <a class="text-accent underline underline-offset-4" href={appLink("tool", slug, "/app/forms")} rel="sponsored noopener" data-placement={`${slug}-cuoi-trang`}>Genius Data</a> (link giới thiệu).</p>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  // Phones: the intro is clamped to 3 lines so the tool shows on the first screen.
  document.addEventListener("click", event => {
    const btn = (event.target as Element | null)?.closest("#tool-lede-more");
    if (!btn) return;
    document.getElementById("tool-lede")?.classList.remove("max-sm:line-clamp-3");
    btn.remove();
  });
</script>
