---
import { getCollection, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import JsonLd from "@/components/JsonLd.astro";
import config from "@/config";
import { variableTermLd } from "@/utils/jsonLd";

export async function getStaticPaths() {
  const vars = await getCollection("variables");
  return vars.map(v => ({ params: { slug: v.id }, props: { v, vars } }));
}

type Props = {
  v: CollectionEntry<"variables">;
  vars: CollectionEntry<"variables">[];
};
const { v, vars } = Astro.props;
const d = v.data;
const locale = Astro.currentLocale ?? config.site.lang;
const abs = (path: string) =>
  new URL(getRelativeLocaleUrl(locale, path), Astro.site).href;
const url = new URL(Astro.url.pathname, Astro.site).href;
const related = d.related
  .map(s => vars.find(x => x.id === s))
  .filter((x): x is CollectionEntry<"variables"> => Boolean(x));
const calcHref = getRelativeLocaleUrl(locale, "cong-cu/tinh-chi-so-tai-chinh");
const strip = (s: string) => s.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&");
const signLabel = {
  "+": "Cùng chiều (+)",
  "-": "Ngược chiều (−)",
  "±": "Chưa thống nhất (±)",
} as const;
const statementName: Record<string, string> = {
  CĐKT: "Bảng cân đối kế toán (B01-DN)",
  KQKD: "Báo cáo kết quả hoạt động kinh doanh (B02-DN)",
  LCTT: "Báo cáo lưu chuyển tiền tệ (B03-DN)",
  "CĐKT-TCTD": "Bảng cân đối kế toán của tổ chức tín dụng",
  "KQKD-TCTD": "Báo cáo kết quả hoạt động kinh doanh của tổ chức tín dụng",
};
const ld = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: d.title,
    description: d.description,
    inLanguage: "vi",
    mainEntityOfPage: url,
    author: { "@type": "Organization", name: config.site.author },
    publisher: {
      "@type": "Organization",
      name: config.site.title,
      url: config.site.url,
    },
    about: `${d.name} (${d.nameEn})`,
    citation: d.references.map(
      r => `${strip(r.text)} https://doi.org/${encodeURI(r.doi)}`
    ),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Trang chủ", item: abs("") },
      {
        "@type": "ListItem",
        position: 2,
        name: "Biến nghiên cứu",
        item: abs("bien-nghien-cuu"),
      },
      { "@type": "ListItem", position: 3, name: d.title, item: url },
    ],
  },
];
---

<Layout title={`${d.title} | ${config.site.title}`} description={d.description}>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(ld[0])}
  />
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(ld[1])}
  />
  <JsonLd slot="head" data={variableTermLd(v, url, abs("bien-nghien-cuu"))} />
  <Header />
  <Breadcrumb current={`${d.symbol}: ${d.name}`} />
  <main id="main-content" class="app-layout pb-10" data-pagefind-body>
    <p class="eyebrow">{d.group}</p>
    <h1
      class="text-foreground mt-2 max-w-4xl text-[1.75rem] font-bold sm:text-[2.25rem]"
    >
      {d.title}
    </h1>

    <dl
      class="border-border mt-6 grid grid-cols-2 gap-x-6 gap-y-4 rounded-xl border p-5 text-sm sm:grid-cols-4"
    >
      <div>
        <dt class="text-muted-foreground">Ký hiệu</dt><dd class="font-semibold">
          {d.symbol}
        </dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Tiếng Anh</dt><dd
          class="font-semibold"
        >
          {d.nameEn}
        </dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Áp dụng cho</dt><dd
          class="font-semibold"
        >
          {d.scope}
        </dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Tài liệu (DOI)</dt><dd
          class="font-semibold"
        >
          {d.references.length}
        </dd>
      </div>
    </dl>

    <div class="app-prose mt-6 max-w-none">
      <h2>Định nghĩa</h2>
      <p>{d.definition}</p>

      <h2>Công thức</h2>
      <p><code class="text-base">{d.formula}</code></p>
      <div class="overflow-x-auto">
        <table class="min-w-[36rem]">
          <thead><tr><th>Chỉ tiêu</th><th>Báo cáo</th><th>Mã số</th></tr></thead
          >
          <tbody>
            {
              d.items.map(i => (
                <tr>
                  <td>
                    {i.label}
                    {i.note && (
                      <span class="text-muted-foreground block text-sm">
                        {i.note}
                      </span>
                    )}
                  </td>
                  <td>{statementName[i.statement] ?? i.statement}</td>
                  <td class="whitespace-nowrap">{i.code ?? "—"}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-sm">
        Mã số theo mẫu báo cáo tài chính của Thông tư 200/2014/TT-BTC (doanh
        nghiệp). Báo cáo của tổ chức tín dụng theo Thông tư 49/2014/TT-NHNN
        không dùng chung hệ mã này, nên chỉ ghi tên chỉ tiêu. Dùng BCTC hợp nhất
        nếu doanh nghiệp có công ty con, và dùng thống nhất cho mọi năm.
      </p>
      {
        d.calc && (
          <div class="not-prose my-4">
            <a class="btn" href={calcHref}>
              Tính {d.symbol} cho nhiều doanh nghiệp, nhiều năm
            </a>
          </div>
        )
      }

      <h2>Các biến thể thường gặp</h2>
      <ul>
        {
          d.variants.map(x => (
            <li>
              <strong>{x.name}:</strong> <code>{x.formula}</code>
              {x.note && <span> {x.note}</span>}
            </li>
          ))
        }
      </ul>

      <h2>Dấu kỳ vọng trong nghiên cứu trước</h2>
      <div class="overflow-x-auto">
        <table class="min-w-[36rem]">
          <thead
            ><tr><th>Quan hệ với</th><th>Dấu</th><th>Ghi chú</th></tr></thead
          >
          <tbody>
            {
              d.relations.map(x => (
                <tr>
                  <td>{x.with}</td>
                  <td class="whitespace-nowrap">{signLabel[x.sign]}</td>
                  <td>{x.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-sm">
        Dấu kỳ vọng là tóm tắt của nghiên cứu trước để viết giả thuyết; kết quả
        trên mẫu của bạn có thể khác.
      </p>

      <h2>Lỗi hay gặp</h2>
      <ul>{d.mistakes.map(m => <li>{m}</li>)}</ul>

      <h2>Code Stata và R</h2>
      <p class="text-sm">
        Tên biến theo file dữ liệu bảng xuất từ <a href={calcHref}
          >công cụ tính chỉ số tài chính</a
        > (<code>firm</code>,
        <code>year</code>, <code>ta</code>, <code>ni</code>…). Biến trễ chỉ hợp
        lệ khi năm liền trước có số liệu.
      </p>
      <h3>Stata</h3>
      <pre><code>{d.stata}</code></pre>
      <h3>R</h3>
      <pre><code>{d.r}</code></pre>

      <h2>Tài liệu tham khảo</h2>
      <ul class="text-sm">
        {
          d.references.map(r => (
            <li>
              <span set:html={r.text} />{" "}
              <a href={`https://doi.org/${encodeURI(r.doi)}`} rel="noopener">
                https://doi.org/{r.doi}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="text-muted-foreground text-sm">
        DOI của từng tài liệu đã được đối chiếu với Crossref (api.crossref.org).
      </p>
    </div>

    {
      related.length > 0 && (
        <section data-pagefind-ignore class="border-border mt-14 border-t pt-8">
          <h2 class="text-foreground mb-4 text-xl font-bold">Biến liên quan</h2>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {related.map(x => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, `bien-nghien-cuu/${x.id}`)}
                  class="card gap-1 p-4"
                >
                  <span class="card-title">{x.data.symbol}</span>
                  <span class="text-muted-foreground block text-sm">
                    {x.data.name}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
