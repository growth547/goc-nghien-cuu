---
import { getCollection, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";
import {
  apaCitation,
  buildChart,
  changeOf,
  displayValue,
  pageTitleOf,
  yearSpan,
} from "@/utils/dataSeries";
import config from "@/config";

export async function getStaticPaths() {
  const datasets = await getCollection("datasets");
  return datasets.map(dataset => ({
    params: { slug: dataset.id },
    props: { dataset, all: datasets },
  }));
}

type Props = {
  dataset: CollectionEntry<"datasets">;
  all: CollectionEntry<"datasets">[];
};
const { dataset, all } = Astro.props;
const d = dataset.data;
const locale = Astro.currentLocale ?? config.site.lang;
const { first, last } = yearSpan(d);
const title = pageTitleOf(d);
const description = `${d.nameVi} của Việt Nam ${first}–${last} theo World Bank (WDI): bảng số liệu từng năm, biểu đồ, tải CSV miễn phí, trích dẫn APA.`;
const latest = d.values[d.values.length - 1];
const missingYears = last - first + 1 - d.values.length;
const chart = buildChart(d);
const cite = apaCitation(d);
const csvHref = getAssetPath(`du-lieu/${dataset.id}.csv`);
const allCsvHref = getAssetPath("du-lieu/tat-ca-chi-so.csv");
const rows = d.values
  .map((p, i) => ({ ...p, change: changeOf(d, d.values[i - 1], p) }))
  .reverse();
const sameTheme = all.filter(
  s => s.id !== dataset.id && s.data.theme === d.theme
);
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: title,
  description: `${description} ${d.explanation}`,
  url,
  inLanguage: "vi",
  isAccessibleForFree: true,
  license: d.licenseUrl,
  creator: {
    "@type": "Organization",
    name: "World Bank",
    url: "https://www.worldbank.org",
  },
  publisher: {
    "@type": "Organization",
    name: config.site.title,
    url: config.site.url,
  },
  isBasedOn: d.dataUrl,
  identifier: d.code,
  keywords: [d.nameVi, d.nameEn, "Việt Nam", "World Development Indicators"],
  variableMeasured: `${d.nameEn} (${d.unit})`,
  temporalCoverage: `${first}/${last}`,
  spatialCoverage: { "@type": "Place", name: "Việt Nam" },
  dateModified: d.lastUpdated,
  distribution: [
    {
      "@type": "DataDownload",
      encodingFormat: "text/csv",
      contentUrl: new URL(csvHref, Astro.site).href,
    },
  ],
  citation: cite.text,
};
---

<Layout title={`${title} | ${config.site.title}`} description={description}>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(ld)}
  />
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-10" data-pagefind-body>
    <p class="text-accent text-xs font-semibold tracking-wider uppercase">
      {d.theme}
    </p>
    <h1 class="mt-1 text-2xl font-semibold sm:text-3xl">{title}</h1>
    <p class="text-muted-foreground mt-2 text-sm">
      {d.nameVi} · <span lang="en">{d.nameEn}</span> · Mã World Bank: <code
        >{d.code}</code
      >
    </p>

    <dl
      class="border-border mt-5 grid grid-cols-2 gap-x-6 gap-y-3 rounded-xl border p-4 text-sm sm:grid-cols-4"
    >
      <div>
        <dt class="text-muted-foreground">Năm {latest.year}</dt>
        <dd class="font-semibold">
          {displayValue(d, latest.value)}
          {d.displayUnit}
        </dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Giai đoạn</dt>
        <dd class="font-semibold">{first}–{last}</dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Số năm có dữ liệu</dt>
        <dd class="font-semibold">{d.values.length}</dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Cập nhật (World Bank)</dt>
        <dd class="font-semibold">{d.lastUpdated}</dd>
      </div>
    </dl>

    <div class="mt-5 flex flex-wrap gap-3">
      <a class="btn" href={csvHref} download>Tải CSV ({d.values.length} năm)</a>
      <a class="btn ghost" href={allCsvHref} download>
        Tải CSV tất cả {all.length} chỉ số
      </a>
    </div>

    <div class="app-prose mt-6 max-w-none">
      <h2>Chỉ số này đo gì?</h2>
      <p>{d.explanation}</p>
      <p class="text-sm">
        <strong>Đơn vị:</strong>
        {d.unit}
        {
          d.scale !== 1 && (
            <>
              {" "}
              (trên trang hiển thị theo {d.displayUnit}; file CSV giữ nguyên giá
              trị gốc)
            </>
          )
        }.
      </p>

      <h2>Khoá luận, luận văn dùng chỉ số này thế nào?</h2>
      <ul>{d.thesisUse.map(u => <li>{u}</li>)}</ul>
      <ul>
        <li>
          Số liệu World Bank có thể khác số liệu của Tổng cục Thống kê (nay là
          Cục Thống kê) do khác phương pháp, thời điểm cập nhật hoặc ước tính.
          Chọn một nguồn cho cả chuỗi và ghi rõ nguồn trong bài.
        </li>
        <li>
          World Bank có thể sửa số liệu các năm trước khi cập nhật. Ghi ngày truy
          cập trong trích dẫn và lưu lại file CSV bạn đã dùng.
        </li>
      </ul>

      <h2>Biểu đồ {d.shortVi} Việt Nam {first}–{last}</h2>
    </div>

    <figure class="mt-2">
      <svg
        viewBox={`0 0 ${chart.width} ${chart.height}`}
        class="h-auto w-full"
        role="img"
        aria-labelledby={`chart-title-${dataset.id}`}
      >
        <title id={`chart-title-${dataset.id}`}>
          {d.nameVi}, Việt Nam {first}–{last}, đơn vị {d.displayUnit}
        </title>
        {
          chart.yTicks.map(t => (
            <g>
              <line
                x1={chart.left}
                x2={chart.right}
                y1={t.y}
                y2={t.y}
                class="stroke-border"
                stroke-width="1"
              />
              <text
                x={chart.left - 8}
                y={t.y + 4}
                text-anchor="end"
                font-size="12"
                class="fill-muted-foreground"
              >
                {t.label}
              </text>
            </g>
          ))
        }
        {
          chart.zeroY !== null && (
            <line
              x1={chart.left}
              x2={chart.right}
              y1={chart.zeroY}
              y2={chart.zeroY}
              class="stroke-muted-foreground"
              stroke-width="1"
            />
          )
        }
        {
          chart.xTicks.map(t => (
            <text
              x={t.x}
              y={chart.bottom + 20}
              text-anchor="middle"
              font-size="12"
              class="fill-muted-foreground"
            >
              {t.label}
            </text>
          ))
        }
        <path
          d={chart.path}
          fill="none"
          class="stroke-accent"
          stroke-width="2.5"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
        {
          chart.dots.map(p => (
            <circle cx={p.x} cy={p.y} r="3.5" class="fill-accent">
              <title>
                {p.year}: {p.label} {d.displayUnit}
              </title>
            </circle>
          ))
        }
      </svg>
      <figcaption class="text-muted-foreground mt-1 text-xs">
        Đơn vị: {d.displayUnit}. Nguồn: World Bank, World Development Indicators
        ({d.code}).{
          missingYears > 0 &&
            ` Đường bị ngắt ở những năm không có số liệu (${missingYears} năm trống).`
        }
      </figcaption>
    </figure>

    <div class="app-prose mt-6 max-w-none">
      <h2>Bảng số liệu {d.shortVi} Việt Nam theo năm</h2>
      <div class="overflow-x-auto">
        <table>
          <thead>
            <tr>
              <th>Năm</th>
              <th>Giá trị ({d.displayUnit})</th>
              <th>Thay đổi so với năm trước</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map(r => (
                <tr>
                  <td class="font-semibold">{r.year}</td>
                  <td class="tabular-nums">{displayValue(d, r.value)}</td>
                  <td class="text-muted-foreground tabular-nums">{r.change}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-sm">
        Năm không có trong bảng là năm World Bank chưa có số liệu cho Việt Nam.
        Số trên trang được làm tròn; file <a href={csvHref} download>CSV</a> giữ
        nguyên độ chính xác gốc, định dạng dài (mỗi dòng một năm), mở được bằng
        Excel, SPSS, Stata, EViews, R.
      </p>

      <h2>Trích dẫn (APA 7)</h2>
      <p class="text-sm">
        Danh mục tài liệu tham khảo:
      </p>
      <blockquote><p set:html={cite.html} /></blockquote>
      <p class="text-sm">
        Trích dẫn trong bài: <strong>{cite.inText}</strong>. Nếu trường của bạn
        dùng kiểu trích dẫn khác, giữ các thành phần: tác giả (World Bank), năm
        cập nhật, tên chỉ số, tên bộ dữ liệu World Development Indicators, đường
        dẫn và ngày truy cập.
      </p>

      <h2>Nguồn và giấy phép</h2>
      <p class="text-sm">
        Dữ liệu: World Bank, {d.source} (mã <code>{d.code}</code>), cập nhật {
          d.lastUpdated
        }, truy xuất qua World Bank API ngày {d.fetchedAt}. Nguồn gốc theo World
        Bank: <span lang="en">{d.sourceOrganization}</span>.
      </p>
      <p class="text-sm">
        Giấy phép: <a href={d.licenseUrl} rel="license noopener" target="_blank"
          >{d.license}</a
        > (xem <a href={d.termsUrl} rel="noopener" target="_blank"
          >điều khoản dữ liệu của World Bank</a
        >). {config.site.title} đã chọn lọc, dịch tên và mô tả sang tiếng Việt,
        định dạng lại bảng và vẽ biểu đồ; không thay đổi giá trị số liệu. Xem dữ
        liệu gốc tại <a href={d.dataUrl} rel="noopener" target="_blank"
          >data.worldbank.org</a
        >.
      </p>
      <details class="text-sm">
        <summary>Định nghĩa gốc của World Bank (tiếng Anh)</summary>
        <p lang="en">{d.sourceNote}</p>
      </details>
    </div>

    {
      sameTheme.length > 0 && (
        <section data-pagefind-ignore class="border-border mt-10 border-t pt-6">
          <h2 class="mb-4 text-xl font-semibold">Số liệu cùng chủ đề</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {sameTheme.map(s => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, `du-lieu/${s.id}`)}
                  class="border-border hover:border-accent block h-full rounded-xl border p-4 transition-colors"
                >
                  <span class="font-semibold">{s.data.nameVi}</span>
                  <span class="text-muted-foreground block text-sm">
                    {yearSpan(s.data).first}–{yearSpan(s.data).last} ·{" "}
                    {s.data.displayUnit}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm">
            <a
              class="text-accent underline"
              href={getRelativeLocaleUrl(locale, "du-lieu")}
            >
              Xem tất cả chỉ số
            </a>
          </p>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
