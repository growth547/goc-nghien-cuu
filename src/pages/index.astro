---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ToolCards from "@/components/ToolCards.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const templates = (await getCollection("templates")).sort((a, b) => a.data.topic.localeCompare(b.data.topic, "vi"));
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-8">
      <p class="text-accent font-semibold">Cho sinh viên làm khoá luận, luận văn</p>
      <h1 class="my-3 text-3xl leading-tight font-bold sm:my-5 sm:text-5xl">
        Chọn khái niệm trong mô hình.<br />1 phút có bảng hỏi và chương 3.
      </h1>
      <p class="text-muted-foreground max-w-2xl text-lg">
        Bảng hỏi tiếng Việt ghép từ thang đo gốc có trích dẫn, cỡ mẫu tối thiểu
        cho PLS-SEM hoặc SPSS, và đoạn “Thang đo và cỡ mẫu” viết sẵn. Tải về
        Word. Miễn phí, không cần đăng ký.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn" href={getRelativeLocaleUrl(locale, "cong-cu/bo-khao-sat")}>Tạo bảng hỏi ngay</a>
        <a class="btn ghost" href={getRelativeLocaleUrl(locale, "cong-cu/tinh-co-mau")}>Chỉ tính cỡ mẫu</a>
      </div>
      <ul class="text-muted-foreground mt-6 grid max-w-3xl gap-2 text-sm sm:grid-cols-3">
        <li>✓ 21 thang đo gốc: TAM, UTAUT2, TPB, SERVQUAL…</li>
        <li>✓ Cỡ mẫu theo G*Power và Kock &amp; Hadaya</li>
        <li>✓ Có câu kiểm tra chú ý, bảng mã hoá Excel</li>
      </ul>
    </section>

    <section id="tools" class="border-border border-b pt-10 pb-10">
      <h2 class="mb-5 text-2xl font-semibold tracking-wide">Công cụ miễn phí</h2>
      <ToolCards />
    </section>

    <section id="templates" class="border-border border-b pt-10 pb-10">
      <h2 class="mb-2 text-2xl font-semibold tracking-wide">Mẫu bảng hỏi theo đề tài</h2>
      <p class="text-muted-foreground mb-5">Có sẵn mô hình, câu hỏi từ thang đo gốc, cỡ mẫu và đoạn chương 3. Mở ra chỉnh tiếp trong Bộ khảo sát.</p>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          templates.map(t => (
            <li>
              <a href={getRelativeLocaleUrl(locale, `mau-bang-hoi/${t.id}`)} class="border-border hover:border-accent block h-full rounded-xl border p-4 transition-colors">
                <span class="font-semibold">{t.data.topic}</span>
                <span class="text-muted-foreground block text-sm">{t.data.audience}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
