---
import { getCollection, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { citeOf, isAgreementScale } from "@/utils/kit";

export async function getStaticPaths() {
  const [concepts, scales] = await Promise.all([getCollection("concepts"), getCollection("scales")]);
  return concepts.map(concept => ({ params: { slug: concept.id }, props: { concept, scales, concepts } }));
}

type Props = {
  concept: CollectionEntry<"concepts">;
  scales: CollectionEntry<"scales">[];
  concepts: CollectionEntry<"concepts">[];
};
const { concept, scales, concepts } = Astro.props;
const d = concept.data;
const locale = Astro.currentLocale ?? config.site.lang;

// Resolve "<scale>:<code>" keys; check-concepts.mjs fails if any key is unknown.
const parts = d.constructs.map(({ key, note }) => {
  const [slug, code] = key.split(":");
  const scale = scales.find(s => s.id === slug)!;
  const c = scale.data.constructs.find(x => x.code === code)!;
  return {
    key,
    note,
    scale,
    c,
    anchor: `${slug}-${code.toLowerCase()}`,
    cite: citeOf(c.source),
    response: scale.data.responseScale.split(/[(.;:,]/)[0].trim(),
  };
});
const hasReverse = parts.some(p => p.c.items.some(i => i.reverse));
const kitBase = getRelativeLocaleUrl(locale, "cong-cu/bo-khao-sat");
const kitHref = (key: string) => `${kitBase}?c=${encodeURIComponent(key)}`;

const related = d.related
  .map(slug => concepts.find(x => x.id === slug))
  .filter((x): x is CollectionEntry<"concepts"> => Boolean(x));
const sameField = concepts
  .filter(x => x.id !== concept.id && x.data.field === d.field && !d.related.includes(x.id))
  .slice(0, Math.max(0, 4 - related.length));

const abs = (path: string) => new URL(getRelativeLocaleUrl(locale, path), Astro.site).href;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: d.title,
    description: d.description,
    inLanguage: "vi",
    mainEntityOfPage: url,
    author: { "@type": "Organization", name: config.site.author },
    publisher: { "@type": "Organization", name: config.site.title, url: config.site.url },
    about: `${d.name} (${d.nameEn})`,
    citation: [...new Set(parts.map(p => p.cite))],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: d.faq.map(f => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Trang chủ", item: abs("") },
      { "@type": "ListItem", position: 2, name: "Thang đo theo khái niệm", item: abs("khai-niem") },
      { "@type": "ListItem", position: 3, name: d.title, item: url },
    ],
  },
];
---

<Layout title={`${d.title} | ${config.site.title}`} description={d.description}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(ld[0])} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(ld[1])} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(ld[2])} />
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-10" data-pagefind-body>
    <p class="text-accent text-xs font-semibold tracking-wider uppercase">{d.field}</p>
    <h1 class="mt-1 text-2xl font-semibold sm:text-3xl">{d.title}</h1>

    <dl class="border-border mt-5 grid grid-cols-2 gap-x-6 gap-y-3 rounded-xl border p-4 text-sm sm:grid-cols-4">
      <div><dt class="text-muted-foreground">Khái niệm</dt><dd class="font-semibold">{d.name}</dd></div>
      <div><dt class="text-muted-foreground">Tiếng Anh</dt><dd class="font-semibold">{d.nameEn}</dd></div>
      <div><dt class="text-muted-foreground">Thang đo trong thư viện</dt><dd class="font-semibold">{parts.length}</dd></div>
      <div><dt class="text-muted-foreground">Biến quan sát</dt><dd class="font-semibold">{parts.reduce((n, p) => n + p.c.items.length, 0)}</dd></div>
    </dl>

    <div class="app-prose mt-6 max-w-none">
      <p>{d.intro}</p>

      <h2>So sánh các thang đo</h2>
      <div class="overflow-x-auto">
        <table>
          <thead>
            <tr>
              <th>Thang đo</th>
              <th>Tác giả (năm)</th>
              <th>Số biến</th>
              <th>Thang trả lời</th>
              <th>Khi nào nên dùng</th>
            </tr>
          </thead>
          <tbody>
            {
              parts.map(p => (
                <tr>
                  <td>
                    <a href={`#${p.anchor}`}>{p.c.nameVi} ({p.c.code})</a>
                    <span class="text-muted-foreground block text-sm">{p.scale.data.name}</span>
                  </td>
                  <td class="whitespace-nowrap">{p.cite}</td>
                  <td>{p.c.items.length}</td>
                  <td>{p.response}</td>
                  <td>{p.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Biến quan sát từng thang đo</h2>
      <p class="text-sm">
        Bản tiếng Việt do ban biên tập dịch để tham khảo. Khi dùng cho nghiên cứu, hãy dịch ngược (back-translation) và chạy thử
        với 20–30 người trước khi phát chính thức. Thay <code>[hệ thống]</code>, <code>[thương hiệu]</code>... bằng đối tượng cụ
        thể trong đề tài của bạn.
      </p>
      {
        parts.map(p => (
          <section>
            <h3 id={p.anchor}>
              {p.c.nameVi} ({p.c.code}){" "}
              <span class="text-muted-foreground text-base font-normal">· {p.scale.data.name}</span>
            </h3>
            <p>{p.c.definition}</p>
            <div class="overflow-x-auto">
              <table>
                <thead>
                  <tr>
                    <th>Mã</th>
                    <th>Biến quan sát (tiếng Việt)</th>
                  </tr>
                </thead>
                <tbody>
                  {p.c.items.map(i => (
                    <tr>
                      <td class="font-semibold whitespace-nowrap">
                        {i.code}
                        {i.reverse && " (R)"}
                      </td>
                      <td>{i.vi}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {!isAgreementScale(p.scale.data.responseScale) && (
              <p class="text-sm">
                <strong>Thang trả lời:</strong> {p.scale.data.responseScale}
              </p>
            )}
            <p class="text-muted-foreground text-sm">
              Nguồn: {p.cite}. Bản gốc tiếng Anh và lưu ý sử dụng:{" "}
              <a href={getRelativeLocaleUrl(locale, `thang-do/${p.scale.id}`)}>thang đo {p.scale.data.name}</a>.
            </p>
            <div class="not-prose mt-3 mb-6 flex flex-wrap gap-3">
              <a class="btn" href={kitHref(p.key)}>Dùng trong Bộ khảo sát</a>
            </div>
          </section>
        ))
      }
      {
        hasReverse && (
          <p class="text-sm">
            (R): câu đảo chiều, đảo điểm trước khi phân tích (thang 5 mức: 6 − điểm; thang 7 mức: 8 − điểm). Thang bắt đầu từ 0
            đảo theo hướng dẫn trên trang thang đo gốc.
          </p>
        )
      }

      <h2>Lưu ý khi dùng</h2>
      <ul>{d.tips.map(tip => <li>{tip}</li>)}</ul>

      <h2>Câu hỏi thường gặp</h2>
      {
        d.faq.map(f => (
          <section>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </section>
        ))
      }
    </div>

    {
      related.length + sameField.length > 0 && (
        <section data-pagefind-ignore class="border-border mt-10 border-t pt-6">
          <h2 class="mb-4 text-xl font-semibold">Khái niệm liên quan</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {[...related, ...sameField].map(x => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, `khai-niem/${x.id}`)}
                  class="border-border hover:border-accent block rounded-xl border p-4 transition-colors"
                >
                  <span class="font-semibold">Thang đo {x.data.name.toLowerCase()}</span>
                  <span class="text-muted-foreground block text-sm">
                    {x.data.nameEn} · {x.data.constructs.length} thang đo
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
