---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const concepts = (await getCollection("concepts")).sort((a, b) => a.data.name.localeCompare(b.data.name, "vi"));
const fields = [...new Set(concepts.map(x => x.data.field))].sort((a, b) => a.localeCompare(b, "vi"));
---

<Layout
  title={`Thang đo theo khái niệm nghiên cứu tiếng Việt | ${config.site.title}`}
  description="Thang đo tiếng Việt xếp theo khái niệm: ý định mua, sự hài lòng, lòng trung thành, chuẩn chủ quan, căng thẳng, kiệt sức. So sánh các thang và chọn thang phù hợp đề tài."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Thang đo theo khái niệm"
    pageDesc={`${concepts.length} khái niệm hay gặp trong khoá luận. Mỗi trang so sánh các thang đo cùng khái niệm trong thư viện, kèm biến quan sát tiếng Việt, cách chọn và lưu ý khi dùng.`}
  >
    {
      fields.map(f => (
        <section class="mb-8">
          <h2 class="mb-3 text-xl font-semibold">{f}</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {concepts
              .filter(x => x.data.field === f)
              .map(x => (
                <li>
                  <a
                    href={getRelativeLocaleUrl(locale, `khai-niem/${x.id}`)}
                    class="border-border hover:border-accent block h-full rounded-xl border p-4 transition-colors"
                  >
                    <span class="font-semibold">Thang đo {x.data.name.toLowerCase()}</span>
                    <span class="text-muted-foreground block text-sm">{x.data.nameEn}</span>
                    <span class="text-muted-foreground mt-1 block text-xs">
                      {x.data.constructs.length} thang đo trong thư viện
                    </span>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </Main>
  <Footer />
</Layout>
