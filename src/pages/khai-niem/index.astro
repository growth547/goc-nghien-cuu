---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ListFilter from "@/components/ListFilter.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const concepts = (await getCollection("concepts")).sort((a, b) => a.data.name.localeCompare(b.data.name, "vi"));
const fields = [...new Set(concepts.map(x => x.data.field))].sort((a, b) => a.localeCompare(b, "vi"));
---

<Layout
  title={`Thang đo theo khái niệm nghiên cứu tiếng Việt | ${config.site.title}`}
  description="Thang đo tiếng Việt xếp theo khái niệm: ý định mua, sự hài lòng, lòng trung thành, chuẩn chủ quan, căng thẳng, kiệt sức. So sánh các thang và chọn thang phù hợp đề tài."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Thang đo theo khái niệm"
    pageDesc={`${concepts.length} khái niệm hay gặp trong khoá luận. Mỗi trang so sánh các thang đo cùng khái niệm trong thư viện, kèm biến quan sát tiếng Việt, cách chọn và lưu ý khi dùng.`}
  >
    <ListFilter
      label="Lọc khái niệm"
      placeholder="Lọc khái niệm, ví dụ: hài lòng, trust, ý định…"
      total={concepts.length}
      unit="khái niệm"
    />
    {
      fields.map(f => (
        <section class="mb-12" data-filter-group>
          <h2 class="text-foreground mb-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-xl font-bold">
            {f}
            <span class="badge neutral">{concepts.filter(x => x.data.field === f).length}</span>
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {concepts
              .filter(x => x.data.field === f)
              .map(x => (
                <li
                  data-filter-item
                  data-filter-text={`${x.data.name} ${x.data.nameEn} ${x.data.keyword}`}
                >
                  <a
                    href={getRelativeLocaleUrl(locale, `khai-niem/${x.id}`)}
                    class="card gap-1 p-4"
                  >
                    <span class="card-title">Thang đo {x.data.name.toLowerCase()}</span>
                    <span class="card-meta">{x.data.nameEn}</span>
                    <span class="card-foot">
                      <span class="badge">{x.data.constructs.length} thang đo trong thư viện</span>
                    </span>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </Main>
  <Footer />
</Layout>
