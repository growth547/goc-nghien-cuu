---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const templates = (await getCollection("templates")).sort((a, b) => a.data.topic.localeCompare(b.data.topic, "vi"));
---

<Layout
  title={`Mẫu bảng hỏi khảo sát khoá luận theo đề tài | ${config.site.title}`}
  description="Mẫu bảng hỏi khảo sát cho các đề tài khoá luận phổ biến: ví điện tử, mua sắm online, ý định nghỉ việc, chất lượng dịch vụ. Có mô hình, cỡ mẫu và nguồn thang đo."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Mẫu bảng hỏi theo đề tài"
    pageDesc={`${templates.length} mẫu bảng hỏi cho các đề tài khoá luận hay gặp. Mỗi mẫu có mô hình gợi ý, câu hỏi từ thang đo gốc, cỡ mẫu và đoạn chương 3; mở trong Bộ khảo sát để chỉnh và tải về Word.`}
  >
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        templates.map(t => (
          <li>
            <a href={getRelativeLocaleUrl(locale, `mau-bang-hoi/${t.id}`)} class="border-border hover:border-accent block h-full rounded-xl border p-4 transition-colors">
              <span class="font-semibold">{t.data.topic}</span>
              <span class="text-muted-foreground block text-sm">{t.data.audience} · {t.data.constructs.length} khái niệm</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
