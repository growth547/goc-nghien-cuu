---
// Reference page: acceptance thresholds for every indicator a quantitative thesis reports.
// All rows, sources and FAQ live in src/data/nguong.json; every source there was opened
// (or quoted by a reliable secondary source) before being cited. Disputed origins are noted per row.
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import JsonLd from "@/components/JsonLd.astro";
import ResponsiveTable from "@/components/ResponsiveTable.astro";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import config from "@/config";
import data from "@/data/nguong.json";

// The results-doctor tool is linked only once it is live (checked when this page was shipped).
const DOCTOR_LIVE = false;

type Source = { cite: string; apa: string; doi?: string; url?: string; urlLabel?: string };
const sources = data.sources as Record<string, Source>;

const locale = Astro.currentLocale ?? config.site.lang;
const link = (p: string) => getRelativeLocaleUrl(locale, p);
// Built from the configured site URL so the citation follows a domain or base-path change.
const siteUrl = config.site.url.replace(/\/?$/, "/");
const pageUrl = new URL("nguong-chap-nhan/", siteUrl).href;

const title = "Ngưỡng chấp nhận các chỉ số trong luận văn định lượng";
const description =
  "Bảng ngưỡng Cronbach's alpha, CR, AVE, KMO, hệ số tải, CFI, RMSEA, HTMT, VIF, R², f², Q², Durbin–Watson, effect size, CMB; mỗi ngưỡng có nguồn gốc kèm DOI và ghi chú khi nguồn hay bị dẫn sai.";
const author = config.site.author;
const [y, m, d] = data.published.split("-");
const vnDate = (iso: string) => iso.split("-").reverse().join("/");
const apaVi = `${author}. (${y}, ngày ${Number(d)} tháng ${Number(m)}). ${title}. ${config.site.title}. ${pageUrl}`;
const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const apaEn = `${config.site.title}. (${y}, ${months[Number(m) - 1]} ${Number(d)}). ${title} [Acceptance thresholds for indicators in quantitative theses]. ${pageUrl}`;

const usedKeys = [...new Set(data.families.flatMap(f => f.rows.flatMap(r => r.src)))];
const refs = usedKeys.map(k => ({ key: k, ...sources[k] })).sort((a, b) => a.apa.localeCompare(b.apa, "en"));
const refText = (s: Source) => `${s.apa}${s.doi ? ` https://doi.org/${s.doi}` : ""}`;

const ld = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    inLanguage: "vi",
    datePublished: data.published,
    dateModified: data.updated,
    mainEntityOfPage: pageUrl,
    url: pageUrl,
    image: new URL(resolveDefaultOgImagePath(config), Astro.site ?? Astro.url).href,
    isPartOf: { "@type": "WebSite", name: config.site.title, url: siteUrl },
    author: { "@type": "Organization", name: author, url: siteUrl },
    publisher: { "@type": "Organization", name: config.site.title, url: siteUrl },
    citation: refs.map(refText),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: data.faq.map(x => ({
      "@type": "Question",
      name: x.q,
      acceptedAnswer: { "@type": "Answer", text: x.a },
    })),
  },
];
const slash = (iso: string) => iso.replace(/-/g, "/");
---

<Layout title={`${title} | ${config.site.title}`} description={description} ogType="article">
  <Fragment slot="head">
    <meta name="citation_title" content={title} />
    <meta name="citation_author" content={author} />
    <meta name="citation_publication_date" content={slash(data.published)} />
    <meta name="citation_online_date" content={slash(data.updated)} />
    <meta name="citation_publisher" content={config.site.title} />
    <meta name="citation_language" content="vi" />
    <meta name="citation_public_url" content={pageUrl} />
  </Fragment>
  <JsonLd slot="head" data={ld} />
  <Header />
  <Breadcrumb />
  <Main pageTitle={title} class="app-prose">
    <p class="text-muted-foreground text-sm">
      {author} · Cập nhật {vnDate(data.updated)} ·
      <a href={link("phuong-phap-bien-soan")}>Cách chúng tôi kiểm chứng</a>
    </p>

    <p>
      <strong>Trả lời nhanh:</strong> Cronbach's alpha và độ tin cậy tổng hợp từ 0,70 (0,60 chấp nhận được trong nghiên
      cứu khám phá, trên 0,95 là đáng ngờ), AVE từ 0,50, hệ số tải ngoài PLS-SEM từ 0,708, HTMT dưới 0,85 (hoặc 0,90 với
      khái niệm gần nghĩa), KMO từ 0,50, và theo Hu &amp; Bentler (1999) CFI/TLI gần 0,95, RMSEA gần 0,06, SRMR gần 0,08.
      Đây là quy ước có điều kiện chứ không phải luật: mỗi dòng dưới đây ghi nguồn gốc của ngưỡng kèm DOI, và ghi rõ khi
      một ngưỡng hay bị gán sai tác giả.
    </p>

    <nav aria-label="Các nhóm chỉ số" class="not-prose my-6">
      <ul class="flex flex-wrap gap-2 text-sm">
        {
          data.families.map(f => (
            <li>
              <a class="border-border hover:border-accent hover:text-accent rounded-full border px-3 py-1" href={`#${f.id}`}>
                {f.title.split(":")[0]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      data.families.map(f => (
        <section aria-labelledby={f.id}>
          <h2 id={f.id}>{f.title}</h2>
          <p>{f.answer}</p>
          <ResponsiveTable variant="striped">
            <table>
              <thead>
                <tr>
                  <th scope="col">Chỉ số</th>
                  <th scope="col">Ngưỡng</th>
                  <th scope="col">Nếu không đạt</th>
                  <th scope="col">Nguồn</th>
                </tr>
              </thead>
              <tbody>
                {f.rows.map(r => (
                  <tr>
                    <th scope="row">{r.indicator}</th>
                    <td>
                      {r.threshold}
                      {"note" in r && r.note && <p class="text-muted-foreground mt-2 text-sm">Lưu ý: {r.note}</p>}
                    </td>
                    <td>{r.fix}</td>
                    <td>
                      {r.src.length ? (
                        r.src.map((k, i) => (
                          <>
                            {i > 0 && "; "}
                            <a href={`#ref-${k}`}>{sources[k].cite}</a>
                          </>
                        ))
                      ) : (
                        <span class="text-muted-foreground">Quy ước, xem lưu ý</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </ResponsiveTable>
          {(f.links.length > 0 || DOCTOR_LIVE) && (
            <p class="text-sm">
              Liên quan:{" "}
              {f.links.map(([p, label], i) => (
                <>
                  {i > 0 && " · "}
                  <a href={link(p)}>{label}</a>
                </>
              ))}
              {DOCTOR_LIVE && (
                <>
                  {f.links.length > 0 && " · "}
                  <a href={link("cong-cu/bac-si-ket-qua")}>Kết quả không đạt? Hỏi Bác sĩ kết quả</a>
                </>
              )}
            </p>
          )}
        </section>
      ))
    }

    <h2 id="dung-the-nao">Dùng bảng này trong luận văn thế nào?</h2>
    <p>
      Trong chương 3, ghi ngưỡng bạn dùng cho từng chỉ số và trích nguồn gốc ở cột "Nguồn" (đọc bài đó, không trích lại
      trang này cho ngưỡng). Trong chương 4, báo cáo giá trị đạt được cạnh ngưỡng, và khi một chỉ số không đạt thì nói rõ
      bạn đã xử lý thế nào thay vì đổi sang ngưỡng lỏng hơn cho vừa kết quả. Muốn chạy các chỉ số này ngay trên trình
      duyệt, dùng <a href={link("cong-cu/phan-tich-du-lieu")}>Phân tích dữ liệu, chương 4</a> (Cronbach, EFA, tương quan,
      hồi quy) hoặc <a href={link("cong-cu/cronbach-alpha")}>Tính Cronbach's alpha</a>; cỡ mẫu cho EFA và PLS-SEM tính ở
      <a href={link("cong-cu/tinh-co-mau")}>Máy tính cỡ mẫu</a>. Xem thêm
      <a href={link("posts/cach-viet-chuong-4-ket-qua-nghien-cuu")}>Cách viết chương 4</a> và
      <a href={link("posts/co-mau-nghien-cuu-bao-nhieu-la-du")}>Cỡ mẫu bao nhiêu là đủ</a>.
    </p>

    <h2 id="faq">Câu hỏi thường gặp</h2>
    {
      data.faq.map(x => (
        <>
          <h3>{x.q}</h3>
          <p>{x.a}</p>
        </>
      ))
    }

    <h2 id="tai-lieu-tham-khao">Tài liệu tham khảo</h2>
    <p class="text-sm">
      Mỗi DOI dưới đây đã được tra trên Crossref; nội dung ngưỡng được đối chiếu với bản toàn văn hoặc một nguồn thứ cấp
      trích nguyên văn. Dòng nào chưa đối chiếu được nguyên văn thì được ghi rõ ở phần "Lưu ý" của bảng.
    </p>
    <ul class="text-sm">
      {
        refs.map(s => (
          <li id={`ref-${s.key}`}>
            {s.apa}{" "}
            {s.doi && <a href={`https://doi.org/${s.doi}`}>https://doi.org/{s.doi}</a>}
            {s.url && (
              <>
                (<a href={s.url}>{s.urlLabel ?? s.url}</a>)
              </>
            )}
          </li>
        ))
      }
    </ul>

    <aside class="not-prose border-border bg-surface my-8 rounded-lg border p-5" aria-labelledby="trich-dan">
      <h2 id="trich-dan" class="text-foreground text-base font-semibold">Trích dẫn trang này</h2>
      <p class="text-muted-foreground mt-1 text-sm">
        Khi dùng một ngưỡng trong luận văn, hãy trích tài liệu gốc ở cột "Nguồn". Trích trang này khi bạn dẫn phần tổng hợp
        hoặc các ghi chú về nguồn gốc ngưỡng.
      </p>
      <p class="mt-3 text-sm font-medium">APA 7 (tiếng Việt)</p>
      <p class="mt-1 text-sm" data-cite>{apaVi}</p>
      <button type="button" class="btn mt-2 text-sm" data-copy={apaVi}>Sao chép</button>
      <p class="mt-4 text-sm font-medium">APA 7 (English)</p>
      <p class="mt-1 text-sm" data-cite>{apaEn}</p>
      <button type="button" class="btn mt-2 text-sm" data-copy={apaEn}>Copy</button>
    </aside>
  </Main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach(btn => {
      btn.addEventListener("click", async () => {
        const label = btn.textContent;
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? "");
          btn.textContent = label === "Copy" ? "Copied" : "Đã sao chép";
        } catch {
          btn.textContent = label === "Copy" ? "Select the text to copy" : "Hãy bôi đen để sao chép";
        }
        setTimeout(() => (btn.textContent = label), 2000);
      });
    });
  });
</script>
