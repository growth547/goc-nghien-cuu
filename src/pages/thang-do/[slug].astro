---
import { getCollection, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import config from "@/config";

export async function getStaticPaths() {
  const [scales, templates] = await Promise.all([
    getCollection("scales"),
    getCollection("templates"),
  ]);
  return scales.map(scale => ({
    params: { slug: scale.id },
    props: {
      scale,
      all: scales,
      // Templates are keyed "<scale slug>:<construct code>".
      usedIn: templates
        .filter(t => t.data.constructs.some(k => k.split(":")[0] === scale.id))
        .sort((a, b) => a.data.topic.localeCompare(b.data.topic, "vi")),
    },
  }));
}

type Props = {
  scale: CollectionEntry<"scales">;
  all: CollectionEntry<"scales">[];
  usedIn: CollectionEntry<"templates">[];
};
const { scale, all, usedIn } = Astro.props;
const d = scale.data;
const locale = Astro.currentLocale ?? config.site.lang;
const itemCount = d.constructs.reduce((n, c) => n + c.items.length, 0);
const hasReverse = d.constructs.some(c => c.items.some(i => i.reverse));
const related = d.related
  .map(slug => all.find(s => s.id === slug))
  .filter((s): s is CollectionEntry<"scales"> => Boolean(s));
const sameField = all
  .filter(
    s =>
      s.id !== scale.id &&
      s.data.field === d.field &&
      !d.related.includes(s.id)
  )
  .slice(0, Math.max(0, 4 - related.length));
const url = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = new URL(config.site.url).href;
// References are stored as HTML; JSON-LD wants plain text.
const toPlainText = (html: string) =>
  html
    .replace(/<[^>]+>/g, "")
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&");
const ld = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  description: d.description,
  inLanguage: "vi",
  mainEntityOfPage: url,
  url,
  image: new URL(resolveDefaultOgImagePath(config), Astro.site ?? Astro.url)
    .href,
  isPartOf: {
    "@type": "WebSite",
    name: config.site.title,
    url: siteUrl,
  },
  author: { "@type": "Organization", name: config.site.author },
  publisher: {
    "@type": "Organization",
    name: config.site.title,
    url: config.site.url,
  },
  about: d.fullName,
  citation: d.references.map(toPlainText),
};
const sampleHref = getRelativeLocaleUrl(locale, "cong-cu/tinh-co-mau");
// Open the survey builder with every construct of this scale preselected.
const kitHref = `${getRelativeLocaleUrl(locale, "cong-cu/bo-khao-sat")}?${new URLSearchParams(
  { c: d.constructs.map(c => `${scale.id}:${c.code}`).join(",") }
)}`;
---

<Layout title={`${d.title} | ${config.site.title}`} description={d.description}>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(ld).replace(/</g, "\\u003c")}
  />
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-10" data-pagefind-body>
    <p class="text-accent text-xs font-semibold tracking-wider uppercase">
      {d.field}
    </p>
    <h1 class="mt-1 text-2xl font-semibold sm:text-3xl">{d.title}</h1>

    <dl
      class="border-border mt-5 grid grid-cols-2 gap-x-6 gap-y-3 rounded-xl border p-4 text-sm sm:grid-cols-4"
    >
      <div>
        <dt class="text-muted-foreground">Mô hình</dt>
        <dd class="font-semibold">{d.name}</dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Khái niệm</dt>
        <dd class="font-semibold">{d.constructs.length}</dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Biến quan sát</dt>
        <dd class="font-semibold">{itemCount}</dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Thang trả lời</dt>
        <dd class="font-semibold">{d.responseScale.split("(")[0].trim()}</dd>
      </div>
    </dl>

    <div class="app-prose mt-6 max-w-none">
      <p>{d.intro}</p>
      <p class="text-sm"><strong>Thang trả lời:</strong> {d.responseScale}</p>

      <h2>Các khái niệm và biến quan sát</h2>
      <p class="text-sm">
        Bản tiếng Việt do ban biên tập dịch để tham khảo. Khi dùng cho nghiên
        cứu, hãy dịch ngược (back-translation) và chạy thử với 20–30 người trước
        khi phát chính thức. Thay <code>[hệ thống]</code>, <code
          >[thương hiệu]</code
        >... bằng đối tượng cụ thể trong đề tài của bạn.
      </p>
      {
        d.constructs.map(c => (
          <section>
            <h3 id={c.code.toLowerCase()}>
              {c.nameVi} ({c.code}){" "}
              <span class="text-muted-foreground text-base font-normal">
                · {c.nameEn}
              </span>
            </h3>
            <p>{c.definition}</p>
            <div class="overflow-x-auto">
              <table>
                <thead>
                  <tr>
                    <th>Mã</th>
                    <th>Biến quan sát (tiếng Việt)</th>
                    <th>Bản gốc (tiếng Anh)</th>
                  </tr>
                </thead>
                <tbody>
                  {c.items.map(i => (
                    <tr>
                      <td class="font-semibold whitespace-nowrap">
                        {i.code}
                        {i.reverse && " (R)"}
                      </td>
                      <td>{i.vi}</td>
                      <td class="text-muted-foreground">{i.en}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="text-muted-foreground text-sm">Nguồn: {c.source}</p>
          </section>
        ))
      }
      {
        hasReverse && (
          <p class="text-sm">
            (R): câu đảo chiều. Khi nhập liệu thang 5 mức, mã hoá lại bằng 6 −
            điểm; thang 7 mức thì 8 − điểm.
          </p>
        )
      }

      <h2>Lưu ý khi sử dụng</h2>
      <ul>{d.usage.map(u => <li>{u}</li>)}</ul>

      <p class="not-prose mt-6">
        <a class="btn" href={kitHref}>Dùng trong Bộ khảo sát</a>
      </p>
      <p class="text-sm">
        Bộ khảo sát mở sẵn {d.constructs.length} khái niệm của {d.name}; bạn ghép
        thêm khái niệm từ thang đo khác, rồi tải bảng hỏi Word, bảng mã hoá Excel
        và đoạn chương 3.
      </p>

      <h2>Cỡ mẫu gợi ý</h2>
      <p>
        {d.sampleSize.note} Tính chính xác cho mô hình của bạn bằng <a
          href={sampleHref}>máy tính cỡ mẫu</a
        >{
          d.sampleSize.arrowsMax && (
            <>
              {" "}
              (chọn PLS-SEM hoặc hồi quy, nhập {d.sampleSize.arrowsMax} mũi tên)
            </>
          )
        }.
      </p>

      <h2>Bản quyền và quyền sử dụng</h2>
      <p>{d.license}</p>

      <h2>Tài liệu tham khảo</h2>
      <ul class="text-sm">{d.references.map(r => <li set:html={r} />)}</ul>
    </div>

    {
      usedIn.length > 0 && (
        <section data-pagefind-ignore class="border-border mt-10 border-t pt-6">
          <h2 class="mb-4 text-xl font-semibold">
            Mẫu bảng hỏi dùng thang đo này
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {usedIn.map(t => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, `mau-bang-hoi/${t.id}`)}
                  class="border-border hover:border-accent block h-full rounded-xl border p-4 transition-colors"
                >
                  <span class="font-semibold">{t.data.topic}</span>
                  <span class="text-muted-foreground block text-sm">
                    {t.data.audience}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      related.length + sameField.length > 0 && (
        <section data-pagefind-ignore class="border-border mt-10 border-t pt-6">
          <h2 class="mb-4 text-xl font-semibold">Thang đo liên quan</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {[...related, ...sameField].map(s => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, `thang-do/${s.id}`)}
                  class="border-border hover:border-accent block rounded-xl border p-4 transition-colors"
                >
                  <span class="font-semibold">{s.data.name}</span>
                  <span class="text-muted-foreground block text-sm">
                    {s.data.fullName}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
