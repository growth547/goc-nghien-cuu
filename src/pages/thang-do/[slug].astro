---
import { getCollection, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import JsonLd from "@/components/JsonLd.astro";
import { scaleTermSetLd } from "@/utils/jsonLd";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import config from "@/config";

export async function getStaticPaths() {
  const [scales, templates, concepts] = await Promise.all([
    getCollection("scales"),
    getCollection("templates"),
    getCollection("concepts"),
  ]);
  return scales.map(scale => ({
    params: { slug: scale.id },
    props: {
      scale,
      all: scales,
      // Templates are keyed "<scale slug>:<construct code>".
      usedIn: templates
        .filter(t => t.data.constructs.some(k => k.split(":")[0] === scale.id))
        .sort((a, b) => a.data.topic.localeCompare(b.data.topic, "vi")),
      // Concept pages (/khai-niem/<slug>/) that compare this scale with others measuring the same construct.
      conceptsOf: concepts
        .filter(c => c.data.constructs.some(k => k.key.split(":")[0] === scale.id))
        .sort((a, b) => a.data.name.localeCompare(b.data.name, "vi")),
    },
  }));
}

type Props = {
  scale: CollectionEntry<"scales">;
  all: CollectionEntry<"scales">[];
  usedIn: CollectionEntry<"templates">[];
  conceptsOf: CollectionEntry<"concepts">[];
};
const { scale, all, usedIn, conceptsOf } = Astro.props;
const d = scale.data;
const locale = Astro.currentLocale ?? config.site.lang;
const itemCount = d.constructs.reduce((n, c) => n + c.items.length, 0);
const hasReverse = d.constructs.some(c => c.items.some(i => i.reverse));
const related = d.related
  .map(slug => all.find(s => s.id === slug))
  .filter((s): s is CollectionEntry<"scales"> => Boolean(s));
const sameField = all
  .filter(
    s =>
      s.id !== scale.id &&
      s.data.field === d.field &&
      !d.related.includes(s.id)
  )
  .slice(0, Math.max(0, 4 - related.length));
const url = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = new URL(config.site.url).href;
// References are stored as HTML; JSON-LD wants plain text.
const toPlainText = (html: string) =>
  html
    .replace(/<[^>]+>/g, "")
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&");
const ld = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  description: d.description,
  inLanguage: "vi",
  mainEntityOfPage: url,
  url,
  image: new URL(resolveDefaultOgImagePath(config), Astro.site ?? Astro.url)
    .href,
  isPartOf: {
    "@type": "WebSite",
    name: config.site.title,
    url: siteUrl,
  },
  author: { "@type": "Organization", name: config.site.author },
  publisher: {
    "@type": "Organization",
    name: config.site.title,
    url: config.site.url,
  },
  about: d.fullName,
  citation: d.references.map(toPlainText),
};
// Committee questions double as an FAQ for search engines.
const faqLd = d.examinerQA?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: d.examinerQA.map(x => ({
        "@type": "Question",
        name: x.q,
        acceptedAnswer: { "@type": "Answer", text: x.a },
      })),
    }
  : null;
const lead = d.keyword.charAt(0).toUpperCase() + d.keyword.slice(1);
const sampleHref = getRelativeLocaleUrl(locale, "cong-cu/tinh-co-mau");
// Open the survey builder with every construct of this scale preselected.
const kitHref = `${getRelativeLocaleUrl(locale, "cong-cu/bo-khao-sat")}?${new URLSearchParams(
  { c: d.constructs.map(c => `${scale.id}:${c.code}`).join(",") }
)}`;
---

<Layout title={`${d.title} | ${config.site.title}`} description={d.description}>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(faqLd ? [ld, faqLd] : ld).replace(/</g, "\\u003c")}
  />
  <JsonLd slot="head" data={scaleTermSetLd(scale, url)} />
  <Header />
  <Breadcrumb current={d.name} />
  <main id="main-content" class="app-layout pb-10" data-pagefind-body>
    <p class="eyebrow">
      {d.field}
    </p>
    <h1 class="text-foreground mt-2 max-w-4xl text-[1.75rem] font-bold sm:text-[2.25rem]">{d.title}</h1>

    <dl
      class="border-border mt-6 grid grid-cols-2 gap-x-6 gap-y-4 rounded-xl border p-5 text-sm sm:grid-cols-4"
    >
      <div>
        <dt class="text-muted-foreground">Mô hình</dt>
        <dd class="font-semibold">{d.name}</dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Khái niệm</dt>
        <dd class="font-semibold">{d.constructs.length}</dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Biến quan sát</dt>
        <dd class="font-semibold">{itemCount}</dd>
      </div>
      <div>
        <dt class="text-muted-foreground">Thang trả lời</dt>
        <dd class="font-semibold">
          {d.responseScaleShort ?? d.responseScale.split("(")[0].trim()}
        </dd>
      </div>
    </dl>

    <div class="app-prose mt-6 max-w-none">
      <p>
        {lead} trên trang này gồm {itemCount} biến quan sát thuộc {
          d.constructs.length
        } khái niệm, có câu gốc tiếng Anh, cách chấm điểm và tài liệu để trích
        dẫn.
      </p>
      <p>{d.intro}</p>
      <p class="text-sm"><strong>Thang trả lời:</strong> {d.responseScale}</p>

      <h2>Biến quan sát thang đo {d.name} (tiếng Việt và bản gốc)</h2>
      <p class="text-sm">
        Bản tiếng Việt do ban biên tập dịch để tham khảo. Khi dùng cho nghiên
        cứu, hãy dịch ngược (back-translation) và chạy thử với 20–30 người trước
        khi phát chính thức. Thay <code>[hệ thống]</code>, <code
          >[thương hiệu]</code
        >... bằng đối tượng cụ thể trong đề tài của bạn.
      </p>
      {
        d.constructs.map(c => (
          <section>
            <h3 id={c.code.toLowerCase()}>
              {c.nameVi} ({c.code}){" "}
              <span class="text-muted-foreground text-base font-normal">
                · {c.nameEn}
              </span>
            </h3>
            <p>{c.definition}</p>
            <div class="overflow-x-auto">
              <table class="sm:min-w-[36rem]">
                <thead>
                  <tr>
                    <th>Mã</th>
                    <th>Biến quan sát (tiếng Việt)</th>
                    <th class="hidden sm:table-cell">Bản gốc (tiếng Anh)</th>
                  </tr>
                </thead>
                <tbody>
                  {c.items.map(i => (
                    <tr>
                      <td class="text-accent font-semibold whitespace-nowrap">
                        {i.code}
                        {i.reverse && " (R)"}
                      </td>
                      <td>
                        {i.vi}
                        <span class="text-muted-foreground mt-1 block text-xs sm:hidden">
                          {i.en}
                        </span>
                      </td>
                      <td class="text-muted-foreground hidden sm:table-cell">
                        {i.en}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="text-muted-foreground text-sm">Nguồn: {c.source}</p>
          </section>
        ))
      }
      {
        hasReverse && (
          <p class="text-sm">
            <strong>(R): câu đảo chiều.</strong> Mã hoá lại trước khi tính điểm:
            điểm mới = (mức thấp nhất + mức cao nhất) − điểm trả lời.{" "}
            {d.reverseRule ??
              "Lấy mức thấp nhất và cao nhất theo đúng thang trả lời của trang này."}
          </p>
        )
      }

      <h2>Lưu ý khi sử dụng thang đo {d.name}</h2>
      <ul>{d.usage.map(u => <li>{u}</li>)}</ul>

      {
        d.model && (
          <>
            <h2>Mô hình gốc của {d.name}: biến nào tác động lên biến nào</h2>
            <ul>{d.model.paths.map(p => <li>{p}</li>)}</ul>
            {d.model.note && <p>{d.model.note}</p>}
            <p class="text-muted-foreground text-sm">Nguồn: {d.model.source}</p>
          </>
        )
      }

      {
        d.reliability && d.reliability.length > 0 && (
          <>
            <h2>Độ tin cậy của {d.name} trong các nghiên cứu đã công bố</h2>
            <div class="overflow-x-auto">
              <table>
                <thead>
                  <tr>
                    <th>Khái niệm</th>
                    <th>Hệ số</th>
                    <th>Mẫu và nguồn</th>
                  </tr>
                </thead>
                <tbody>
                  {d.reliability.map(r => (
                    <tr>
                      <td>{r.construct}</td>
                      <td>{r.value}</td>
                      <td>
                        {r.sample}
                        <span class="text-muted-foreground block text-xs">
                          <a href={r.url} rel="noopener">
                            {r.source}
                          </a>
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="text-sm">
              Đây là số liệu của nghiên cứu khác, không thay cho kiểm định trên
              dữ liệu của bạn. Khi viết chương 4, so sánh hệ số của bạn với các
              con số này và trích đúng nguồn.
            </p>
          </>
        )
      }

      {
        d.vietnamStudies && d.vietnamStudies.length > 0 && (
          <>
            <h2>Nghiên cứu ở Việt Nam đã dùng thang đo {d.name}</h2>
            <ul>
              {d.vietnamStudies.map(v => (
                <li>
                  {v.authors} ({v.year}). {v.title}. <em>{v.journal}</em>.{" "}
                  <a href={v.url} rel="noopener">
                    Xem bài
                  </a>
                  {v.note && <> {v.note}</>}
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        d.examinerQA && d.examinerQA.length > 0 && (
          <>
            <h2>Câu hỏi hội đồng hay hỏi về thang đo {d.name}</h2>
            {d.examinerQA.map(x => (
              <>
                <h3>{x.q}</h3>
                <p>{x.a}</p>
              </>
            ))}
          </>
        )
      }

      <p class="not-prose mt-6">
        <a class="btn" href={kitHref}>Dùng trong Bộ khảo sát</a>
      </p>
      <p class="text-sm">
        Bộ khảo sát mở sẵn {d.constructs.length} khái niệm của {d.name}; bạn ghép
        thêm khái niệm từ thang đo khác, rồi tải bảng hỏi Word, bảng mã hoá Excel
        và đoạn chương 3.
      </p>

      <h2>Cỡ mẫu gợi ý cho {d.name}</h2>
      <p>
        {d.sampleSize.note} Tính chính xác cho mô hình của bạn bằng <a
          href={sampleHref}>máy tính cỡ mẫu</a
        >{
          d.sampleSize.arrowsMax && (
            <>
              {" "}
              (chọn PLS-SEM hoặc hồi quy, nhập {d.sampleSize.arrowsMax} mũi tên)
            </>
          )
        }.
      </p>

      <h2>Phân tích thang đo {d.name} sau khi thu dữ liệu</h2>
      <p>
        Kiểm tra độ tin cậy từng khái niệm bằng <a href="/cong-cu/cronbach-alpha/"
          >công cụ tính Cronbach's alpha online</a
        >, rồi chạy EFA, tương quan và hồi quy trong <a href="/cong-cu/phan-tich-du-lieu/"
          >công cụ phân tích dữ liệu khảo sát</a
        >. Đối chiếu kết quả với <a href="/nguong-chap-nhan/"
          >bảng ngưỡng chấp nhận Cronbach, KMO, AVE, HTMT</a
        >; chỉ số nào không đạt thì <a href="/cong-cu/bac-si-ket-qua/"
          >bác sĩ kết quả</a
        > gợi ý cách xử lý hợp lệ. Để trình bày quan hệ giữa các khái niệm, dùng <a
          href="/cong-cu/ve-mo-hinh/">công cụ vẽ mô hình nghiên cứu</a
        >; mô hình có biến trung gian hoặc điều tiết thì kiểm định bằng <a href="/cong-cu/trung-gian-dieu-tiet/"
          >công cụ kiểm định biến trung gian, điều tiết</a
        >. Muốn so sánh với thang đo khác cùng khái niệm, xem {
          conceptsOf.length > 0 ? (
            <>
              {conceptsOf.map((c, i) => (
                <>
                  {i > 0 && (i === conceptsOf.length - 1 ? " và " : ", ")}
                  <a href={`/khai-niem/${c.id}/`}>{c.data.keyword}</a>
                </>
              ))}{" "}
              (trang so sánh các thang đo cùng khái niệm) hoặc toàn bộ <a href="/khai-niem/">thang đo theo khái niệm</a>
            </>
          ) : (
            <a href="/khai-niem/">thang đo theo khái niệm</a>
          )
        }.
      </p>

      <h2>Bản quyền và quyền sử dụng {d.name}</h2>
      <p>{d.license}</p>

      <h2>Tài liệu tham khảo thang đo {d.name}</h2>
      <ul class="text-sm">{d.references.map(r => <li set:html={r} />)}</ul>
      <p class="text-sm">
        Các tài liệu khác trong khoá luận định dạng theo cùng chuẩn bằng <a href="/cong-cu/trich-dan-apa/"
          >công cụ trích dẫn APA 7 online</a
        >: dán DOI là có mục tài liệu tham khảo.
      </p>
    </div>

    {
      usedIn.length > 0 && (
        <section data-pagefind-ignore class="border-border mt-14 border-t pt-8">
          <h2 class="text-foreground mb-4 text-xl font-bold">
            Mẫu bảng hỏi dùng thang đo này
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {usedIn.map(t => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, `mau-bang-hoi/${t.id}`)}
                  class="card gap-1 p-4"
                >
                  <span class="card-title">{t.data.topic}</span>
                  <span class="text-muted-foreground block text-sm">
                    {t.data.audience}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      related.length + sameField.length > 0 && (
        <section data-pagefind-ignore class="border-border mt-14 border-t pt-8">
          <h2 class="text-foreground mb-4 text-xl font-bold">Thang đo liên quan</h2>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {[...related, ...sameField].map(s => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, `thang-do/${s.id}`)}
                  class="card gap-1 p-4"
                >
                  <span class="card-title">{s.data.name}</span>
                  <span class="text-muted-foreground block text-sm">
                    {s.data.fullName}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
