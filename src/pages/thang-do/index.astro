---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ListFilter from "@/components/ListFilter.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const scales = (await getCollection("scales")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "vi")
);
const fields = [...new Set(scales.map(s => s.data.field))];
const itemsOf = (s: (typeof scales)[number]) =>
  s.data.constructs.reduce((n, c) => n + c.items.length, 0);
const totalItems = scales.reduce((n, s) => n + itemsOf(s), 0);
const fieldId = (f: string) => `linh-vuc-${fields.indexOf(f) + 1}`;
---

<Layout
  title={`Thư viện thang đo nghiên cứu tiếng Việt | ${config.site.title}`}
  description="Thư viện thang đo dịch sẵn sang tiếng Việt: TAM, UTAUT2, TPB, SERVQUAL, thương hiệu, nhân sự, tâm lý. Có biến quan sát, bản gốc, trích dẫn và cỡ mẫu gợi ý."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Thư viện thang đo"
    pageDesc={`${scales.length} thang đo và mô hình hay dùng trong khoá luận (${totalItems} biến quan sát), dịch sẵn sang tiếng Việt kèm bản gốc và trích dẫn.`}
  >
    <ListFilter
      label="Lọc thang đo"
      placeholder="Lọc theo tên, ví dụ: TAM, hài lòng, stress…"
      total={scales.length}
      unit="thang đo"
    />
    <nav aria-label="Lĩnh vực" class="-mt-4 mb-10 flex flex-wrap gap-2">
      {
        fields.map(f => (
          <a
            href={`#${fieldId(f)}`}
            class="border-border bg-surface hover:border-accent hover:text-accent inline-flex min-h-9 items-center gap-2 rounded-full border px-3.5 text-sm font-medium transition-colors"
          >
            {f}
            <span class="text-muted-foreground tabular-nums">
              {scales.filter(s => s.data.field === f).length}
            </span>
          </a>
        ))
      }
    </nav>
    {
      fields.map(f => (
        <section class="mb-12" data-filter-group aria-labelledby={fieldId(f)}>
          <h2 id={fieldId(f)} class="text-foreground mb-4 flex items-center gap-3 text-xl font-bold">
            {f}
            <span class="badge neutral">{scales.filter(s => s.data.field === f).length}</span>
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {scales
              .filter(s => s.data.field === f)
              .map(s => (
                <li
                  data-filter-item
                  data-filter-text={`${s.data.name} ${s.data.fullName} ${s.data.keyword} ${s.data.constructs.map(c => `${c.nameVi} ${c.nameEn} ${c.code}`).join(" ")}`}
                >
                  <a
                    href={getRelativeLocaleUrl(locale, `thang-do/${s.id}`)}
                    class="card gap-1 p-4"
                  >
                    <span class="text-accent text-[1.05rem] font-bold">{s.data.name}</span>
                    <span class="card-meta line-clamp-2">{s.data.fullName}</span>
                    <span class="card-foot">
                      <span>{s.data.constructs.length} khái niệm</span>
                      <span>{itemsOf(s)} biến quan sát</span>
                    </span>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
    <aside class="border-border bg-accent-soft/60 mt-4 flex flex-col items-start gap-3 rounded-xl border p-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-foreground">
        Chưa biết chọn thang nào? Xem
        <a class="text-accent font-semibold underline underline-offset-4" href={getRelativeLocaleUrl(locale, "khai-niem")}>thang đo theo khái niệm</a>
        để so sánh các thang cùng đo một khái niệm.
      </p>
      <a class="btn flex-none" href={getRelativeLocaleUrl(locale, "cong-cu/bo-khao-sat")}>Tạo bảng hỏi</a>
    </aside>
  </Main>
  <Footer />
</Layout>
